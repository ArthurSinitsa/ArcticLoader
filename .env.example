# Скопируй в .env и поправь под себя: cp .env.example .env

# --- База данных ---
POSTGRES_USER=arctic
POSTGRES_PASSWORD=arctic
POSTGRES_DB=arctic
# Хост db — имя сервиса в docker-compose
DATABASE_URL=postgresql+asyncpg://arctic:arctic@db:5432/arctic

# --- Redis (брокер ARQ и будущий pub/sub прогресса) ---
REDIS_URL=redis://redis:6379/0

# --- Хранилище ---
# Путь внутри контейнера; на хост монтируется как ./data/media
MEDIA_ROOT=/srv/media
# Базовый адрес, по которому Caddy отдаёт готовые файлы
PUBLIC_FILES_BASE_URL=http://localhost:8080/files

# --- Лимиты (раздел 3 плана) ---
# Глобальный семафор: сколько загрузок воркеры тянут одновременно
MAX_CONCURRENT_DOWNLOADS=4
# Таймаут одной задачи, секунды
DOWNLOAD_TIMEOUT_SECONDS=1800
# Формат по умолчанию для yt-dlp
DEFAULT_FORMAT=bv*+ba/b

# --- Прочее ---
LOG_LEVEL=INFO
