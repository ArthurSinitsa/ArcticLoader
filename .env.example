# Скопируй в .env и поправь под себя: cp .env.example .env

# --- База данных ---
POSTGRES_USER=arctic
POSTGRES_PASSWORD=arctic
POSTGRES_DB=arctic
# Хост db — имя сервиса в docker-compose
DATABASE_URL=postgresql+asyncpg://arctic:arctic@db:5432/arctic

# --- Redis (брокер ARQ и будущий pub/sub прогресса) ---
REDIS_URL=redis://redis:6379/0

# --- Хранилище ---
# Путь внутри контейнера; на хост монтируется как ./data/media
MEDIA_ROOT=/srv/media
# Базовый адрес, по которому Caddy отдаёт готовые файлы
PUBLIC_FILES_BASE_URL=http://localhost:8080/files

# --- Лимиты (раздел 3 плана) ---
# Глобальный семафор: сколько загрузок воркеры тянут одновременно
MAX_CONCURRENT_DOWNLOADS=4
# Таймаут одной задачи, секунды
DOWNLOAD_TIMEOUT_SECONDS=1800
# Кэш списка форматов, секунды (раздел 3.1)
URL_META_TTL_SECONDS=1800
# Отдавать progressive-форматы прямой ссылкой на CDN (раздел 1.5)
DIRECT_LINKS_ENABLED=true

# --- Первая учётная запись (раздел 2.6) ---
# Публичной регистрации нет: без этой пары администрировать сервис некому.
# Учётка создаётся один раз при старте API; пароль обязателен к смене при
# первом входе, и перезапуск его уже не возвращает. Пустой email — не создавать.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Суперадминистратор

# --- Срок жизни файлов и чистка (раздел 3) ---
# Что не забрали за двое суток, почти наверняка уже не заберут
FILE_TTL_HOURS=48
# Как часто просыпается чистка
CLEANUP_INTERVAL_MINUTES=30
# Ниже порога новые загрузки не начинаются: 5 ГБ
MIN_FREE_DISK_BYTES=5368709120

# --- Сессии и вход (разделы 2.6 и 4.4) ---
# Неделя со скользящим продлением
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=arctic_session
# На проде за TLS обязательно true: иначе cookie уедет по открытому каналу.
# Локально сервис работает по HTTP, и с true браузер её просто не сохранит.
SESSION_COOKIE_SECURE=false
# Пять неудач по связке IP + логин закрывают вход на пятнадцать минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=900

# Рубильники раздела 3.6 (анонимный доступ, приём заявок, обслуживание)
# живут в БД и переключаются из админки — в .env их больше нет.

# --- Прочее ---
LOG_LEVEL=INFO
